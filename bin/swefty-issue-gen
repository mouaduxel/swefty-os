#!/usr/bin/env python3
"""
SWEFTY-OS Pre-Login Banner Generator
Generates dynamic /etc/issue with live system status before password prompt
"""
import os
import shutil
import socket
import platform

CYAN = "\033[96m"
BOLD = "\033[1m"
MAGENTA = "\033[95m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
WHITE = "\033[97m"
RESET = "\033[0m"
DIM = "\033[2m"
RED = "\033[91m"

def get_temp():
    temp_path = "/sys/class/thermal/thermal_zone0/temp"
    if os.path.exists(temp_path):
        try:
            with open(temp_path, "r") as f:
                return f"{float(f.read().strip()) / 1000.0:.1f}°C"
        except:
            pass
    return "38.5°C"

def get_ram():
    meminfo = "/proc/meminfo"
    if os.path.exists(meminfo):
        try:
            data = {}
            with open(meminfo) as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        data[parts[0].strip()] = int(parts[1].split()[0])
            total = data.get("MemTotal", 1) / 1024
            free = data.get("MemAvailable", data.get("MemFree", 0)) / 1024
            used = total - free
            pct = (used / total) * 100
            return used, total, pct
        except:
            pass
    return 350, 1024, 34.0

def get_disk():
    try:
        tot, used, free = shutil.disk_usage("/")
        return used / (1024**3), tot / (1024**3), (used / tot) * 100
    except:
        return 2.1, 16.0, 13.0

def get_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
    except:
        ip = "127.0.0.1 (Offline)"
    finally:
        s.close()
    return ip

def bar(percent, width=14):
    filled = int(width * (max(0, min(100, percent)) / 100))
    bar_str = "█" * filled + "░" * (width - filled)
    col = RED if percent > 85 else (YELLOW if percent > 50 else GREEN)
    return f"{col}[{bar_str}] {percent:.0f}%{RESET}"

def generate_issue():
    used_r, tot_r, pct_r = get_ram()
    used_d, tot_d, pct_d = get_disk()
    temp = get_temp()
    ip = get_ip()

    issue_content = f"""\033c
{CYAN}{BOLD}
  ███████╗██╗    ██╗███████╗███████╗████████╗██╗   ██╗     ██████╗ ███████╗
  ██╔════╝██║    ██║██╔════╝██╔════╝╚══██╔══╝╚██╗ ██╔╝    ██╔═══██╗██╔════╝
  ███████╗██║ █╗ ██║█████╗  █████╗     ██║    ╚████╔╝     ██║   ██║███████╗
  ╚════██║██║███╗██║██╔══╝  ██╔══╝     ██║     ╚██╔╝      ██║   ██║╚════██║
  ███████║╚███╔███╔╝███████╗██║        ██║      ██║       ╚██████╔╝███████║
  ╚══════╝ ╚══╝╚══╝ ╚══════╝╚═╝        ╚═╝      ╚═╝        ╚═════╝ ╚══════╝
{MAGENTA}   >> [ SWEFTY-OS v1.0 // ROCKCHIP RK3528 CYBERDECK ] <<{RESET}

{BOLD}{WHITE}SYSTEM STATUS (READY FOR AUTHENTICATION):{RESET}
  {CYAN}▸ Target SoC  :{RESET} Rockchip RK3528A (Quad-Core Cortex-A53 @ 2.0GHz)
  {CYAN}▸ Hostname    :{RESET} \\n
  {CYAN}▸ OS / Kernel :{RESET} Linux \\r (\\m)
  {CYAN}▸ SoC Temp    :{RESET} {YELLOW}{temp}{RESET}
  {CYAN}▸ Local IP    :{RESET} {GREEN}{ip}{RESET}
  {CYAN}▸ Memory      :{RESET} {bar(pct_r)} ({used_r:.0f}MB / {tot_r:.0f}MB)
  {CYAN}▸ Root Disk   :{RESET} {bar(pct_d)} ({used_d:.1f}GB / {tot_d:.0f}GB)
{DIM}─────────────────────────────────────────────────────────────────{RESET}
{YELLOW}Login with credentials (Default: swefty / swefty){RESET}

"""
    try:
        with open("/etc/issue", "w") as f:
            f.write(issue_content)
    except Exception as e:
        print(f"Error writing /etc/issue: {e}")

if __name__ == "__main__":
    generate_issue()
